{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laminari Launcher",
  "version": "0.2.0",
  "identifier": "app.laminari.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Laminari Launcher",
        "width": 1280,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
